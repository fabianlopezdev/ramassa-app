{
  // Dead-code gate (RAPP-120): `bun run qa:deadcode`, also run in CI.
  // Every ignore below carries its reason. Prefer fixing the code to adding one.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        // Guard that makes Expo fail fast when run from the monorepo root.
        "app.config.js",
        // Scripts are run directly with `bun run <file>` from package.json or by hand.
        "scripts/**/*.{ts,mjs}",
        "tests/**/*.ts",
      ],
      "project": ["scripts/**/*.{ts,mjs}", "tests/**/*.ts"],
      // The Supabase CLI is a developer and CI tool installed outside the repo
      // (CI pins it with `bunx supabase@<version>`), so it is not a dependency.
      "ignoreBinaries": ["supabase"],
      // Pinned on purpose (RAPP-75): NativeWind's Metro integration resolves Tailwind 3
      // from the hoisted root while the admin app uses Tailwind 4.
      "ignoreDependencies": ["tailwindcss"],
      // Supabase Edge Functions run on Deno with their own deno.json import map,
      // outside the bun workspaces.
      "ignore": ["supabase/functions/**"],
    },
    "apps/mobile": {
      "entry": [
        // Isolated suites, loaded in their own process by tests/setup/run-isolated-test.ts.
        "src/**/*.case.{ts,tsx}",
        // Metro picks `<name>.web.tsx` over `<name>.tsx` on web, so nothing imports them by name.
        "src/**/*.web.{ts,tsx}",
        // Expo config plugins listed in app.json.
        "plugins/*.cjs",
      ],
      "project": ["src/**/*.{ts,tsx,css}", "plugins/*.cjs"],
      // knip cannot load metro.config.js: NativeWind resolves tailwind.config from the
      // process cwd, which is the repo root here. Metro adds no entry files of its own.
      "metro": false,
      // knip infers expo-updates unless app.json disables updates. Ramassa ships no
      // over-the-air updates today; that decision stays open in RAPP-68.
      "ignoreDependencies": ["expo-updates"],
    },
    "apps/admin": {
      // CSS is included so knip reads the Tailwind 4 `@import`s in src/styles/app.css.
      "project": ["src/**/*.{ts,tsx,css}"],
      // shadcn/ui primitives are vendored with their upstream API, so a later
      // `shadcn add` or update stays a clean diff. Unused members are expected there.
      "ignoreIssues": { "src/components/ui/**": ["exports", "types"] },
    },
    "packages/*": {
      "project": ["**/*.{ts,tsx}"],
      // Generated by `bun run db:types` (supabase gen types); never edited by hand.
      "ignoreIssues": { "types/database.ts": ["exports", "types"] },
    },
    "workers/*": {
      "project": ["src/**/*.ts"],
    },
  },
}
