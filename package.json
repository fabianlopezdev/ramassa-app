{
  "name": "ramassa",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "overrides": {
    "@hono/node-server": "1.19.15",
    "@react-native/metro-config": "0.88.0-rc.3",
    "@xmldom/xmldom": "0.9.12",
    "baseline-browser-mapping": "2.11.27",
    "brace-expansion": "5.0.12",
    "browserslist": "4.29.3",
    "decode-uri-component": "0.5.0",
    "fast-uri": "3.1.8",
    "hono": "4.13.12",
    "ip-address": "10.7.2",
    "js-yaml": "4.3.2",
    "moment": "2.31.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "qs": "6.16.0",
    "react-native": "0.88.0-rc.3",
    "sharp": "0.35.5",
    "undici": "7.29.1",
    "uuid": "11.1.1"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && bun run --cwd packages/shared typecheck && bun run --cwd apps/mobile typecheck && bun run --cwd apps/admin typecheck && bun run --cwd workers/media typecheck && bun run --cwd workers/translation typecheck",
    "test": "bun test",
    "mobile:ios": "bun run --cwd apps/mobile ios",
    "mobile:android": "bun run --cwd apps/mobile android",
    "mobile:start": "bun run --cwd apps/mobile start",
    "admin:dev": "bun run --cwd apps/admin dev",
    "media:dev": "bun run --cwd workers/media dev",
    "media:deploy": "bun run --cwd workers/media deploy",
    "translation:dev": "bun run --cwd workers/translation dev",
    "translation:deploy": "bun run --cwd workers/translation deploy",
    "db:reset": "supabase db reset && bun run push:scheduler:configure",
    "db:test": "supabase test db",
    "db:test:signup-race": "bun run scripts/verify-event-signup-race.ts",
    "db:test:forum-flag-race": "bun run scripts/verify-forum-flag-race.ts",
    "db:test:media-deletion": "bun run scripts/verify-media-deletion.ts",
    "db:types": "supabase gen types typescript --local > packages/shared/types/database.ts",
    "push:scheduler:configure": "bun run scripts/configure-local-push-scheduler.ts",
    "push:catalog:generate": "bun run scripts/generate-push-edge-catalog.ts",
    "municipalities:generate": "bun run scripts/generate-municipalities.ts",
    "capture:flow": "bun run scripts/capture-flow.ts",
    "capture:phase": "bun run scripts/capture-phase.ts",
    "qa:smoke": "bun run scripts/qa-smoke.ts",
    "security:audit": "bun run scripts/verify-dependency-audit.ts",
    "qa:android:tab-labels": "bun run scripts/qa-android-tab-labels.ts",
    "qa:web": "env -u NO_COLOR playwright test",
    "qa:accessibility:web": "env -u NO_COLOR playwright test scripts/qa-web/accessibility.web-qa.ts",
    "deploy:check-env": "bun run scripts/validate-deployment-env.ts",
    "mobile:ios:ramassa": "bun run --cwd apps/mobile ios:ramassa"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.7.0",
    "eslint-plugin-i18next": "6.1.5",
    "globals": "^17.7.0",
    "lefthook": "^2.1.10",
    "playwright": "^1.62.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "trustedDependencies": [
    "@sentry/cli"
  ],
  "patchedDependencies": {
    "expo-localization@58.0.2": "patches/expo-localization@58.0.2.patch",
    "@sentry/react-native@7.11.0": "patches/@sentry%2Freact-native@7.11.0.patch",
    "@expo/plist@0.10.1": "patches/@expo%2Fplist@0.10.1.patch"
  }
}
