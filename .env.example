# Copy to .env and fill in real values. NEVER commit .env (gitignored).
# Supabase (local dev via `bunx supabase start`; prod = Frankfurt project)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Media Worker origin (RAPP-14). `bun run media:dev` serves it on 8787 locally.
EXPO_PUBLIC_MEDIA_WORKER_URL=

# Translation Worker origin (RAPP-29). `bun run translation:dev` serves it on 8788 by default.
EXPO_PUBLIC_TRANSLATION_WORKER_URL=

# Sentry (RAPP-12). DSNs are ingest addresses, not secrets.
# Mobile project DSN (Sentry project `react-native`, EU):
EXPO_PUBLIC_SENTRY_DSN=
# Admin project DSN (Sentry project `ramassa-admin`, EU):
VITE_SENTRY_DSN=
SENTRY_DSN=
# Org auth token for source-map upload (SECRET — local .env and EAS/CI secrets only):
SENTRY_AUTH_TOKEN=
# Optional: exact organization slug used for public colors before login (default: ramassa).
EXPO_PUBLIC_ORGANIZATION_SLUG=ramassa

# Player preview from the web admin (RAPP-372). The admin build opens the player
# web app at EXPO_PUBLIC_PLAYER_WEB_URL; the player web build accepts the
# preview only from EXPO_PUBLIC_ADMIN_WEB_URL. Leave both unset to hide it.
# EXPO_PUBLIC_PLAYER_WEB_URL=https://player.example.org
# EXPO_PUBLIC_ADMIN_WEB_URL=https://admin.example.org

# Staging builds only (RAPP-616). "true" lets the sign-in code step also accept the
# fixed code of a TEST account through the staging `test-sign-in` Edge Function
# (see supabase/functions/test-sign-in/README.md). Production builds never set it,
# and `bun run deploy:check-env` refuses it when TARGET_ENV=production.
# EXPO_PUBLIC_TEST_SIGN_IN=true
