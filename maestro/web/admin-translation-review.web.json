{
  "slug": "admin-translation-review",
  "viewport": { "width": 1440, "height": 900 },
  "deviceScaleFactor": 2,
  "timezoneId": "Europe/Madrid",
  "settle": { "timeout": 6000, "interval": 150 },
  "steps": [
    {
      "label": "auth-open",
      "goto": "/login",
      "click": "button:has-text(\"{{auth:usePasswordInstead}}\")",
      "waitFor": "input[type=\"password\"]"
    },
    {
      "label": "auth-submit",
      "fill": [
        { "selector": "input[type=\"email\"]", "value": "{{staff:email}}" },
        { "selector": "input[type=\"password\"]", "value": "{{staff:password}}" }
      ],
      "click": "button:has-text(\"{{auth:passwordAction}}\")",
      "waitFor": "text={{admin:dashboardTitle}}"
    },
    {
      "label": "source",
      "goto": "/content/announcements/new",
      "fill": [
        { "selector": "[data-testid=\"title-source\"]", "value": "Entrenament cancel·lat" },
        {
          "selector": "[data-testid=\"body-source\"]",
          "value": "L'entrenament de dissabte ha quedat cancel·lat."
        }
      ],
      "waitFor": "[data-testid=\"announcement-generate\"] >> visible=true",
      "fullPage": true
    },
    {
      "label": "drafts",
      "click": "[data-testid=\"announcement-generate\"]",
      "waitFor": "[data-testid=\"title-draft-es\"] >> visible=true",
      "fullPage": true
    },
    {
      "label": "accepted",
      "click": "[data-testid=\"title-approve-es\"]",
      "waitFor": "[data-testid=\"title-status-es-approved\"] >> visible=true",
      "fullPage": true
    },
    {
      "label": "edited",
      "fill": [
        {
          "selector": "[data-testid=\"title-draft-en\"]",
          "value": "Training has been cancelled"
        }
      ],
      "click": "[data-testid=\"title-approve-en\"]",
      "waitFor": "[data-testid=\"title-status-en-approved\"] >> visible=true",
      "fullPage": true
    },
    {
      "label": "rejected",
      "click": "[data-testid=\"title-reject-ar\"]",
      "waitFor": "[data-testid=\"title-status-ar-rejected\"] >> visible=true",
      "fullPage": true
    },
    {
      "label": "manual",
      "fill": [
        {
          "selector": "[data-testid=\"title-draft-ar\"]",
          "value": "تم إلغاء التدريب"
        }
      ],
      "click": "[data-testid=\"title-approve-ar\"]",
      "waitFor": "[data-testid=\"title-status-ar-approved\"] >> visible=true",
      "fullPage": true
    },
    {
      "label": "body-approved",
      "click": "[data-testid=\"body-approve-all\"]",
      "waitFor": "[data-testid=\"body-status-fa-approved\"] >> visible=true",
      "fullPage": true
    },
    {
      "label": "approved",
      "click": "[data-testid=\"title-approve-all\"]",
      "waitFor": "[data-testid=\"title-status-fa-approved\"] >> visible=true",
      "fullPage": true
    }
  ]
}
